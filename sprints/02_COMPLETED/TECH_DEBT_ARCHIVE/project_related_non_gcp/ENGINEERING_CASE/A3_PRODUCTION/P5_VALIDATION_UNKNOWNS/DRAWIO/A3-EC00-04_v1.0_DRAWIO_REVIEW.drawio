  <diagram id="A3-EC00-04" name="A3-EC00-04">
    <mxGraphModel dx="1587" dy="1123" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1123" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1587" height="1123" as="geometry"/></mxCell>
        <mxCell id="title" value="SCOPE &amp;amp; OPEN QUESTIONS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#10243E;fontSize=27;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="question" value="Which operator-specific technical assumptions, interfaces, constraints, responsibilities, and pilot parameters must be jointly validated with Beeline before the HouseMaster reference architecture can become a validated pilot architecture?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#42566F;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1010" height="46" as="geometry"/></mxCell>
        <mxCell id="control" value="P5-01  •  ASSEMBLY 023  •  PT-08 TBD / VALIDATION REGISTER  •  IR FROZEN  •  PAGE_SPEC_READY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7EDF5;strokeColor=#8093AA;fontColor=#20364F;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="30" width="487" height="48" as="geometry"/></mxCell>
        <mxCell id="thesis" value="&lt;b&gt;15 UNRESOLVED QUESTIONS  •  7 VALIDATION TRACKS&lt;/b&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;NONE ANSWERED&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;OWNER ASSIGNMENTS 0&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;NO BEELINE COMMITMENT" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="1507" height="38" as="geometry"/></mxCell>
        <mxCell id="tbdMeaning" value="&lt;b&gt;TBD WITH BEELINE&lt;/b&gt; = Operator-specific implementation detail requiring validation with Beeline.&lt;br&gt;&lt;b&gt;DOES NOT MEAN:&lt;/b&gt; architecture error / missing HouseMaster design / assumed Beeline capability / Beeline commitment." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#C29A47;fontColor=#4A3A1B;fontSize=9;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="746" height="58" as="geometry"/></mxCell>
        <mxCell id="informationBoundary" value="&lt;b&gt;BEELINE FULL INTERNAL NETWORK / PLATFORM DISCLOSURE IS NOT REQUIRED&lt;/b&gt;&lt;br&gt;Only information needed to validate the agreed integration surface is requested. No Beeline internal architecture is depicted." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9F0F7;strokeColor=#66809C;fontColor=#17365D;fontSize=9;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="801" y="160" width="746" height="58" as="geometry"/></mxCell>

        <mxCell id="registerA" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;border-collapse:collapse;table-layout:fixed;font-family:Arial;font-size:8px;color:#20364F;border-color:#AEBBCC&quot;&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-01  CONNECTIVITY / SIGNAL PATH&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q1&lt;/b&gt;  What IoT/M2M connectivity models can Beeline support for a Connected Building pilot?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F2F5F9&quot;&gt;&lt;td&gt;&lt;b&gt;Q2&lt;/b&gt;  Which transport options and connectivity-state events can be exposed to an external domain platform such as HouseMaster?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q3&lt;/b&gt;  What network-side constraints should be assumed for basement, technical-room and other difficult indoor MCD environments?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-02  IDENTITY / LIFECYCLE&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F2F5F9&quot;&gt;&lt;td&gt;&lt;b&gt;Q4&lt;/b&gt;  Which SIM/eSIM/M2M identity objects and lifecycle states can Beeline expose to HouseMaster?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q5&lt;/b&gt;  What provisioning, activation, suspension, replacement and deactivation interfaces are available or feasible?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="493" height="444" as="geometry"/></mxCell>
        <mxCell id="registerB" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;border-collapse:collapse;table-layout:fixed;font-family:Arial;font-size:8px;color:#20364F;border-color:#AEBBCC&quot;&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-03  API / DATA&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q6&lt;/b&gt;  Which operator APIs, events or integration interfaces are available for connectivity management and telemetry/event exchange?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F2F5F9&quot;&gt;&lt;td&gt;&lt;b&gt;Q7&lt;/b&gt;  Which data objects may cross the Beeline ↔ HouseMaster boundary, and what restrictions apply?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q8&lt;/b&gt;  Which interaction model is preferred: synchronous API, asynchronous events, webhook/callback, message transport, or another operator-approved mechanism?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-04  SECURITY / TRUST&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F2F5F9&quot;&gt;&lt;td&gt;&lt;b&gt;Q9&lt;/b&gt;  What authentication, authorization and trust model would Beeline require for HouseMaster integration?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q10&lt;/b&gt;  What security, audit, logging, credential and incident-response requirements must the pilot satisfy?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="547" y="232" width="493" height="444" as="geometry"/></mxCell>
        <mxCell id="registerC" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;border-collapse:collapse;table-layout:fixed;font-family:Arial;font-size:8px;color:#20364F;border-color:#AEBBCC&quot;&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-05  DEPLOYMENT / CLOUD&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q11&lt;/b&gt;  What infrastructure or cloud role, if any, should Beeline play in the pilot architecture?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F2F5F9&quot;&gt;&lt;td&gt;&lt;b&gt;Q12&lt;/b&gt;  What Kazakhstan data-residency, resilience, backup, DR and deployment constraints should be incorporated into the validated architecture?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-06  OPERATIONS / SLA&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q13&lt;/b&gt;  How should operational responsibility be divided between Beeline connectivity operations and HouseMaster building-domain operations?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F2F5F9&quot;&gt;&lt;td&gt;&lt;b&gt;Q14&lt;/b&gt;  What incident, escalation, observability, support and SLA/SLO interfaces can be agreed for the pilot?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#17365D;color:#FFFFFF;font-size:10px&quot;&gt;&lt;th&gt;TECH-07  PILOT&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Q15&lt;/b&gt;  What minimum pilot scope, technical acceptance criteria, participants and duration would Beeline consider sufficient to make a scale-up decision?&lt;br&gt;&lt;font style=&quot;font-size:7px&quot;&gt;STATUS: TBD WITH BEELINE  •  DECISION: TBD  •  OWNER / NOTE: UNASSIGNED / BLANK&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1054" y="232" width="493" height="444" as="geometry"/></mxCell>

        <mxCell id="outcomes" value="&lt;b&gt;ARCHITECTURE-VALIDATION OUTCOMES — 4 EQUAL OPTIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CONFIRM&lt;/b&gt; — Reference model applies&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;&lt;b&gt;REPLACE&lt;/b&gt; — Use Beeline actual / alternative mechanism&lt;br&gt;&lt;b&gt;CONSTRAIN&lt;/b&gt; — Apply technical / security / operational limit&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;&lt;b&gt;REMOVE&lt;/b&gt; — Not used in pilot&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Not commercial / approval / contract / deployment statuses. No ranking, score, winner, or traffic-light semantics.&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9F0F7;strokeColor=#66809C;fontColor=#17365D;fontSize=9;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="540" height="112" as="geometry"/></mxCell>
        <mxCell id="pipelines" value="&lt;b&gt;VALIDATION PIPELINES&lt;/b&gt;&lt;br&gt;&lt;br&gt;HOUSEMASTER REFERENCE ARCHITECTURE + BEELINE TECHNICAL INPUT → &lt;b&gt;JOINT VALIDATION&lt;/b&gt; → VALIDATED PILOT ARCHITECTURE&lt;br&gt;&lt;br&gt;TBD → &lt;b&gt;CONFIRM / REPLACE / CONSTRAIN / REMOVE&lt;/b&gt; → PILOT DESIGN&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;VALIDATED PILOT ARCHITECTURE ≠ PRODUCTION ARCHITECTURE&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#8093AA;fontColor=#20364F;fontSize=9;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="594" y="690" width="580" height="112" as="geometry"/></mxCell>
        <mxCell id="expected" value="&lt;b&gt;EXPECTED AFTER JOINT VALIDATION — 7&lt;/b&gt;&lt;br&gt;1 Confirmed integration capabilities&lt;br&gt;2 Agreed alternative mechanisms&lt;br&gt;3 Documented technical constraints&lt;br&gt;4 Removed out-of-scope assumptions&lt;br&gt;5 Assigned unresolved TBDs&lt;br&gt;6 Validated integration surface&lt;br&gt;7 Inputs for Pilot Architecture v0.1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#C29A47;fontColor=#4A3A1B;fontSize=8;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1188" y="690" width="359" height="112" as="geometry"/></mxCell>
        <mxCell id="openStatus" value="&lt;b&gt;OPEN / TBD STATUS&lt;/b&gt;  •  OPEN/TBD 15  •  TBD WITH BEELINE 15  •  DECISION = TBD 15  •  OWNER ASSIGNMENTS 0  •  UNASSIGNED / BLANK IS AN OPEN FIELD, NOT APPROVAL" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C29A47;fontColor=#4A3A1B;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="1507" height="38" as="geometry"/></mxCell>

        <mxCell id="gr01" value="1  REFERENCE ARCHITECTURE ≠ BEELINE INTERNAL ARCHITECTURE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="40" y="866" width="367" height="48" as="geometry"/></mxCell>
        <mxCell id="gr02" value="2  VALIDATED PILOT ARCHITECTURE ≠ PRODUCTION ARCHITECTURE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="420" y="866" width="367" height="48" as="geometry"/></mxCell>
        <mxCell id="gr03" value="3  TBD WITH BEELINE ≠ ARCHITECTURE ERROR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="800" y="866" width="367" height="48" as="geometry"/></mxCell>
        <mxCell id="gr04" value="4  TBD WITH BEELINE ≠ MISSING HOUSEMASTER DESIGN" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1180" y="866" width="367" height="48" as="geometry"/></mxCell>
        <mxCell id="gr05" value="5  TBD WITH BEELINE ≠ ASSUMED BEELINE CAPABILITY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="493" height="48" as="geometry"/></mxCell>
        <mxCell id="gr06" value="6  TBD WITH BEELINE ≠ BEELINE COMMITMENT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="547" y="926" width="493" height="48" as="geometry"/></mxCell>
        <mxCell id="gr07" value="7  VALIDATION INPUT / OUTCOME ≠ COMMERCIAL COMMITMENT OR STATUS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1054" y="926" width="493" height="48" as="geometry"/></mxCell>

        <mxCell id="exclusions" value="NOT an approval sheet / readiness scorecard / commercial status page / Beeline commitment page / production architecture page. No SEM-MCD-001, scoring, maturity or readiness percentage, severity colors, approval badge, Beeline architecture diagram, deployment diagram, implementation drawing, commercial layer, ALAU AI, or 3D." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F0F3F7;strokeColor=#AEBBCC;fontColor=#42566F;fontSize=8;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="988" width="1507" height="46" as="geometry"/></mxCell>
        <mxCell id="footer" value="PAGE / GRAPH: A3-EC00-04   |   PRODUCTION: P5-01   |   ASSEMBLY: 023   |   PT-08 TBD / VALIDATION REGISTER   |   QUESTIONS 15   |   TRACKS 7   |   QUESTION→TRACK 15   |   OUTCOMES 4   |   OPEN/TBD 15   |   OWNER ASSIGNMENTS 0   |   EXPECTED OUTPUTS 7   |   GUARDRAILS 7   |   SEM-MCD-001 NOT INCLUDED   |   PDF NOT EXPORTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE5EF;strokeColor=#AEBBCC;fontColor=#42566F;fontSize=8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1044" width="1507" height="34" as="geometry"/></mxCell>
