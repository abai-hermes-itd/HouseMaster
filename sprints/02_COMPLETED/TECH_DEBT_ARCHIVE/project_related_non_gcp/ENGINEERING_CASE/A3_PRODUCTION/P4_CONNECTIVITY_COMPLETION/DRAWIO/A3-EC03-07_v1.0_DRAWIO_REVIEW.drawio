        <mxCell id="zoneA" value="&lt;b&gt;ZONE A  •  REFERENCE ORIGIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SEM-MCD-001&lt;/b&gt; — Semey, Shakarima 13A&lt;br&gt;&lt;b&gt;HEATING&lt;/b&gt; = VERIFIED&lt;br&gt;&lt;b&gt;HEATING ENTRY&lt;/b&gt; = CANDIDATE / LOCATION TBD&lt;br&gt;&lt;br&gt;&lt;b&gt;HEATING VERIFIED ≠ HEATING ENTRY LOCATION ESTABLISHED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;No installed equipment is shown or inferred.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F0F7;strokeColor=#66809C;fontColor=#17365D;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="300" height="184" as="geometry"/></mxCell>
        <mxCell id="zoneB" value="&lt;b&gt;ZONE B  •  OBSERVATION / DEVICE / CONNECTIVITY CANDIDATES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;OBS-CAND-001&lt;/b&gt; — CANDIDATE&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;&lt;b&gt;DEV-CAND-001&lt;/b&gt; — CANDIDATE / NOT INSTALLED DEVICE&lt;br&gt;&lt;br&gt;&lt;b&gt;DEVICE FUNCTIONS — 6&lt;/b&gt;&lt;br&gt;MEASURE / TIMESTAMP / BUFFER / STORE / FORWARD / REPORT STATUS&lt;br&gt;&lt;br&gt;&lt;b&gt;CP-CAND-001 — CANDIDATE / 5 CHARACTERISTICS&lt;/b&gt;&lt;br&gt;LATENCY = MEDIUM&amp;nbsp; • &amp;nbsp;LOSS TOLERANCE = MEDIUM&amp;nbsp; • &amp;nbsp;STORE-AND-FORWARD = HIGH&lt;br&gt;REACHABILITY IMPORTANCE = MEDIUM&amp;nbsp; • &amp;nbsp;MOBILITY = FIXED&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Qualitative values are not normalized into numeric scoring.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#C29A47;fontColor=#4A3A1B;fontSize=9;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="354" y="326" width="590" height="184" as="geometry"/></mxCell>
        <mxCell id="zoneC" value="&lt;b&gt;ZONE C  •  DIRECT REFERENCE PATTERN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DIRECT CONNECTIVITY PATTERN&lt;/b&gt;&lt;br&gt;PROPOSED ARCHITECTURAL ALTERNATIVE&lt;br&gt;REFERENCE WALK-THROUGH ONLY&lt;br&gt;&lt;b&gt;NOT SELECTED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;REFERENCE DIRECT FLOW ≠ DIRECT TOPOLOGY SELECTION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Edge is not rejected.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEAF5;strokeColor=#7D6B9B;fontColor=#3F3159;fontSize=9;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="958" y="326" width="280" height="184" as="geometry"/></mxCell>
        <mxCell id="zoneD" value="&lt;b&gt;ZONE D  •  BEELINE HANDOFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BEELINE ACCESS / TRANSPORT&lt;/b&gt;&lt;br&gt;CONNECTIVITY / TRANSPORT DOMAIN&lt;br&gt;IMPLEMENTATION NOT ESTABLISHED&lt;br&gt;&lt;br&gt;&lt;b&gt;BEELINE ACCESS / TRANSPORT ≠ BEELINE INTERNAL IMPLEMENTATION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;No internal network detail is shown.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7EEF5;strokeColor=#4F7196;fontColor=#17365D;fontSize=9;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1252" y="326" width="295" height="184" as="geometry"/></mxCell>

        <mxCell id="zoneE" value="&lt;b&gt;ZONE E  •  HOUSEMASTER BOUNDARY + DOMAIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;HOUSEMASTER TRUST / INTEGRATION BOUNDARY&lt;/b&gt; — PROPOSED BOUNDARY / IMPLEMENTATION NOT ESTABLISHED&lt;br&gt;&lt;b&gt;HOUSEMASTER INTEGRATION EDGE&lt;/b&gt; — PROPOSED ARCHITECTURE / IMPLEMENTATION NOT ESTABLISHED&lt;br&gt;&lt;br&gt;&lt;b&gt;OBSERVATION  →  EVIDENCE  →  BUILDING STATE&lt;/b&gt; — three separate semantic stages; no automatic verification, defect confirmation, or connectivity-to-building-state inference.&lt;br&gt;&lt;br&gt;&lt;b&gt;HOUSEMASTER TRUST / INTEGRATION BOUNDARY ≠ IMPLEMENTED API OR SECURITY DESIGN&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E5F0F0;strokeColor=#557F80;fontColor=#214C4D;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="1000" height="148" as="geometry"/></mxCell>
        <mxCell id="tbd" value="&lt;b&gt;OPEN / TBD — 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EC03-07-TBD-01&lt;/b&gt;&lt;br&gt;Heating entry candidate location = &lt;b&gt;TBD / NOT ESTABLISHED&lt;/b&gt;&lt;br&gt;Validation owner = &lt;b&gt;NOT ESTABLISHED IN §26&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;No room, entrance, riser, node, mounting location, or survey result is inferred.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#C29A47;fontColor=#4A3A1B;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1054" y="524" width="493" height="148" as="geometry"/></mxCell>

