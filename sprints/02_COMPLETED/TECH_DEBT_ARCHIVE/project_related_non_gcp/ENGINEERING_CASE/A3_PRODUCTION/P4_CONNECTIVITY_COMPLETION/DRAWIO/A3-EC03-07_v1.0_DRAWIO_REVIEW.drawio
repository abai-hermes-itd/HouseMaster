        <mxCell id="gr06" value="6  NO REAL NETWORK TECHNOLOGY / PROTOCOL / PRODUCT IS INSTANTIATED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1054" y="772" width="493" height="50" as="geometry"/></mxCell>

        <mxCell id="responsibility" value="&lt;b&gt;RESPONSIBILITY DOMAINS — 2&lt;/b&gt;&lt;br&gt;&lt;b&gt;BEELINE&lt;/b&gt; = CONNECTIVITY / TRANSPORT DOMAIN&amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp;&lt;b&gt;HOUSEMASTER&lt;/b&gt; = TRUST / INTEGRATION BOUNDARY + INTEGRATION EDGE + OBSERVATION + EVIDENCE + BUILDING STATE&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PLANE COUNT = 0. DATA / CONTROL / OPERATIONS planes are not rendered.&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#DDE7F0;strokeColor=#8093AA;fontColor=#20364F;fontSize=10;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="1507" height="72" as="geometry"/></mxCell>
        <mxCell id="exclusions" value="&lt;b&gt;REFERENCE FLOW — NOT DEPLOYED ARCHITECTURE&lt;/b&gt;  •  No installed equipment, SIM inventory, gateway, APN/private network, protocol, coverage, RF result, API/security implementation, cloud service, 3D, ALAU AI, or commercial content." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F0F3F7;strokeColor=#AEBBCC;fontColor=#42566F;fontSize=9;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="922" width="1507" height="54" as="geometry"/></mxCell>
