        <mxCell id="title" value="CONNECTIVITY STATE / REACHABILITY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#10243E;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="920" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Connectivity state tells HouseMaster what is known about the path; it does not by itself establish physical or engineering condition." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#42566F;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="960" height="32" as="geometry"/></mxCell>
