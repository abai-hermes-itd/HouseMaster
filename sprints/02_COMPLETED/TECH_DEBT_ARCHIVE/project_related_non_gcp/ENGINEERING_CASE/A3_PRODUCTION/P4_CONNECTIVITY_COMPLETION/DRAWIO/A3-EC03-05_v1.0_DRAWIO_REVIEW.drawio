        <mxCell id="gr04" value="REACHABLE WITH NO EVENT ≠ NECESSARILY NORMAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="976" width="493" height="48" as="geometry"/></mxCell>
