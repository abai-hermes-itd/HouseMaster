        <mxCell id="rc03a" value="&lt;b&gt;03  DEVICE REACHABLE BUT NO ENGINEERING EVENT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#AEBBCC;fontColor=#10243E;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="330" height="84" as="geometry"/></mxCell>
        <mxCell id="rc03b" value="Connectivity confirmed responsive, but no telemetry/event content" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEBBCC;fontColor=#20364F;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="370" y="560" width="365" height="84" as="geometry"/></mxCell>
        <mxCell id="rc03c" value="Transport path itself is functioning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEBBCC;fontColor=#20364F;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="735" y="560" width="330" height="84" as="geometry"/></mxCell>
        <mxCell id="rc03d" value="&lt;b&gt;Absence of an event necessarily means normal.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Event-driven: silence may be expected. Continuous/periodic: silence may indicate an unclassified device/interface issue.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#C29A47;fontColor=#3E3420;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="1065" y="560" width="482" height="84" as="geometry"/></mxCell>
        <mxCell id="rc04a" value="&lt;b&gt;04  DEVICE REACHABLE AND OBSERVATION DELIVERED&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#AEBBCC;fontColor=#10243E;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="rc04b" value="Connectivity and content both confirmed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FBFD;strokeColor=#AEBBCC;fontColor=#20364F;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="370" y="644" width="365" height="76" as="geometry"/></mxCell>
        <mxCell id="rc04c" value="Reported value/event is available for domain interpretation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FBFD;strokeColor=#AEBBCC;fontColor=#20364F;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="735" y="644" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="rc04d" value="&lt;b&gt;Delivered value is automatically a verified engineering fact.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Preserve: Observation → Symptom → Defect gating.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4DA;strokeColor=#C29A47;fontColor=#3E3420;fontSize=10;align=left;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="1065" y="644" width="482" height="76" as="geometry"/></mxCell>

        <mxCell id="responsibility" value="&lt;b&gt;ZONE D  •  RESPONSIBILITY BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;HOUSEMASTER&lt;/b&gt; — integration-state vocabulary; permitted-knowledge semantics; domain interpretation; evidence gating.&lt;br&gt;&lt;b&gt;BEELINE&lt;/b&gt; — connectivity / transport domain.&lt;br&gt;&lt;br&gt;&lt;b&gt;HOUSEMASTER CONNECTIVITY STATES ≠ BEELINE INTERNAL NETWORK STATES&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;No Beeline state mapping is inferred.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9F0F7;strokeColor=#66809C;fontColor=#17365D;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="738" width="600" height="144" as="geometry"/></mxCell>
        <mxCell id="tbd" value="&lt;b&gt;ZONE E  •  OPEN / TBD — 4&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EC03-05-TBD-01&lt;/b&gt;  Joint validation of seven-state HouseMaster vocabulary&lt;br&gt;&lt;b&gt;EC03-05-TBD-02&lt;/b&gt;  Heartbeat interval = NOT DEFINED&lt;br&gt;&lt;b&gt;EC03-05-TBD-03&lt;/b&gt;  Timeout value = NOT DEFINED&lt;br&gt;&lt;b&gt;EC03-05-TBD-04&lt;/b&gt;  Polling frequency = NOT DEFINED&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;No value is inferred or supplied.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#C29A47;fontColor=#3E3420;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="657" y="738" width="890" height="144" as="geometry"/></mxCell>

