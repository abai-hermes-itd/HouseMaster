        <mxCell id="boundary" value="&lt;b&gt;PROPOSED HOUSEMASTER INTEGRATION STATES&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; ≠ &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;BEELINE INTERNAL NETWORK STATES&lt;/b&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1507" height="42" as="geometry"/></mxCell>

        <mxCell id="zoneb" value="ZONE B  •  HOUSEMASTER CONNECTIVITY-STATE VOCABULARY  •  7 SEMANTIC PEERS  •  NO ORDER / NO TRANSITIONS / NO SEVERITY SCALE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#42566F;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="154" width="1507" height="24" as="geometry"/></mxCell>
        <mxCell id="cs01" value="&lt;b&gt;UNKNOWN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No connectivity information has ever been received for this device/profile.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="207" height="160" as="geometry"/></mxCell>
        <mxCell id="cs02" value="&lt;b&gt;PROVISIONED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A connectivity profile is conceptually associated with a device; reachability not yet confirmed.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="257" y="182" width="207" height="160" as="geometry"/></mxCell>
        <mxCell id="cs03" value="&lt;b&gt;REACHABLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Connectivity path currently confirmed responsive.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="474" y="182" width="207" height="160" as="geometry"/></mxCell>
        <mxCell id="cs04" value="&lt;b&gt;UNREACHABLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Connectivity path currently not responding; cause not yet classified.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="691" y="182" width="207" height="160" as="geometry"/></mxCell>
        <mxCell id="cs05" value="&lt;b&gt;DEGRADED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Connectivity path responsive but reduced quality, such as delayed delivery, without being fully unreachable.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="908" y="182" width="207" height="160" as="geometry"/></mxCell>
        <mxCell id="cs06" value="&lt;b&gt;SUSPENDED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Connectivity intentionally paused by administrative action.&lt;br&gt;&lt;b&gt;NOT A FAULT.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1125" y="182" width="207" height="160" as="geometry"/></mxCell>
        <mxCell id="cs07" value="&lt;b&gt;DECOMMISSIONED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Device/connectivity profile retired and no longer expected to report.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#66809C;fontColor=#17365D;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1342" y="182" width="205" height="160" as="geometry"/></mxCell>

