        <mxCell id="functionLegend" value="&lt;b&gt;FUNCTION SET LEGEND — EXACT&lt;/b&gt;&lt;br&gt;&lt;b&gt;FSET-MEASURE&lt;/b&gt; = MEASURE / TIMESTAMP / BUFFER / STORE / FORWARD / REPORT STATUS&lt;br&gt;&lt;b&gt;FSET-READ&lt;/b&gt; = READ INTERFACE / COUNT / TIMESTAMP / BUFFER / STORE / FORWARD / REPORT STATUS&lt;br&gt;&lt;b&gt;FSET-DETECT&lt;/b&gt; = DETECT / TIMESTAMP / BUFFER / STORE / FORWARD / REPORT STATUS&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;UPLINK ONLY = 14  •  UPLINK + DOWNLINK = 2  •  UPLINK + DOWNLINK ≠ ENGINEERING ACTUATION&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9F0F7;strokeColor=#66809C;fontColor=#17365D;fontSize=9;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="600" height="126" as="geometry"/></mxCell>
