        <mxCell id="gr03" value="3  CONCEPTUAL ARCHITECTURE READY ≠ IMPLEMENTED OR DEPLOYED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="800" y="780" width="367" height="48" as="geometry"/></mxCell>
        <mxCell id="gr04" value="4  PATTERN LABELS = PLAUSIBILITY, NOT TOPOLOGY SELECTION" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1180" y="780" width="367" height="48" as="geometry"/></mxCell>
        <mxCell id="gr05" value="5  CONNECTIVITY PROFILE ≠ SIM / TARIFF / APN / VPN / NETWORK TECHNOLOGY / OPERATOR PRODUCT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="367" height="52" as="geometry"/></mxCell>
        <mxCell id="gr06" value="6  UPLINK + DOWNLINK ≠ ENGINEERING ACTUATION" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="420" y="840" width="367" height="52" as="geometry"/></mxCell>
        <mxCell id="gr07" value="7  D-CLASS-05 IS CONCEPTUAL ONLY; NO EDGE-01 IS NAMED OR PLACED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="800" y="840" width="367" height="52" as="geometry"/></mxCell>
        <mxCell id="gr08" value="8  MASTER MATRIX VALUES ARE SOURCE-REUSED; NO CELL MAY BE INVENTED OR NORMALIZED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1180" y="840" width="367" height="52" as="geometry"/></mxCell>

        <mxCell id="boundary" value="&lt;b&gt;PROVIDER-NEUTRAL&lt;/b&gt;  •  RESPONSIBILITY DOMAINS 0  •  PLANES 0  •  TRUST / ACCESS / INTEGRATION BOUNDARY NOT APPLICABLE  •  DIRECT-FRIENDLY ≠ DIRECT SELECTED  •  EDGE-FRIENDLY ≠ EDGE SELECTED  •  BOTH PLAUSIBLE = CO-APPLICABLE / NOT SEQUENTIAL / NOT SELECTED" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#DDE7F0;strokeColor=#8093AA;fontColor=#20364F;fontSize=8;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="906" width="1507" height="54" as="geometry"/></mxCell>
        <mxCell id="exclusions" value="No responsibility swimlanes, Trust boundary, DATA / CONTROL / OPERATIONS planes, winner colors, severity heatmap, deployment icons, Direct/Edge flow, network topology, SIM/device/gateway inventory, ALAU AI, or 3D." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F0F3F7;strokeColor=#AEBBCC;fontColor=#42566F;fontSize=8;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="972" width="1507" height="42" as="geometry"/></mxCell>
        <mxCell id="reference" value="&lt;b&gt;REFERENCE CONTEXT ONLY&lt;/b&gt;  •  SEM-MCD-001 — Semey, Shakarima 13A  •  No new building fact inferred  •  SOURCE: EC-03 §33  •  DIRECT DEFINITIONS: §§16–19 / §25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#20364F;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1507" height="22" as="geometry"/></mxCell>
        <mxCell id="footer" value="PAGE / GRAPH: A3-EC03-08   |   PRODUCTION: P4-05   |   ASSEMBLY: 022   |   PT-04 MASTER MATRIX   |   IR FROZEN   |   PAGE_SPEC_READY   |   ROWS 16   |   COLUMNS 13   |   SECONDARY 12   |   RELATIONSHIPS 192   |   OPEN/TBD 2   |   GUARDRAILS 8   |   PDF NOT EXPORTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE5EF;strokeColor=#AEBBCC;fontColor=#42566F;fontSize=8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="1507" height="32" as="geometry"/></mxCell>
