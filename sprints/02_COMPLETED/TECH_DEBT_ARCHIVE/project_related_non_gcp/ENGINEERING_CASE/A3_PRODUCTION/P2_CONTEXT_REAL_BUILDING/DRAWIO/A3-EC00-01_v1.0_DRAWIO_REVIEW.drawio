        <mxCell id="legend" value="&lt;b&gt;OWNERSHIP / RESPONSIBILITY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;&lt;b&gt;REAL BUILDING&lt;/b&gt; = physical engineering reality   ·   &lt;b&gt;OBSERVATION / FIELD&lt;/b&gt; = human/documentary + candidate machine observation&lt;br&gt;&lt;b&gt;BEELINE&lt;/b&gt; = connectivity / IoT-M2M / SIM-eSIM / operator transport / exposed state   ·   &lt;b&gt;TRUST / INTEGRATION&lt;/b&gt; = explicit crossing; no domain ownership transfer&lt;br&gt;&lt;b&gt;HOUSEMASTER&lt;/b&gt; = domain identities / observation-evidence / engineering state / history-workflow / system of record   ·   &lt;b&gt;ALAU AI&lt;/b&gt; = downstream analytics / prediction / decision-support only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;verticalAlign=middle;fontFamily=Arial;fontSize=9;fillColor=#FFFFFF;strokeColor=#757575;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="57" y="765" width="925" height="118" as="geometry"/></mxCell>
