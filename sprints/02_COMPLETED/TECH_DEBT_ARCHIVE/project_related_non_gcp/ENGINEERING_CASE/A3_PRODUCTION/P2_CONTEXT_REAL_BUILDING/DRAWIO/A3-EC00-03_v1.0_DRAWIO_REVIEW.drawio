        <mxCell id="H4" value="OPERATIONAL CONSEQUENCE" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;fillColor=#153A73;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1022" y="220" width="508" height="42" as="geometry"/></mxCell>

        <mxCell id="AX-01" axiom_id="AX-01" canonical_statement="CONNECTIVITY STATE ≠ ENGINEERING STATE" domain="STATE_SEPARATION" why_it_exists="Connectivity/reachability describes a path; engineering state requires evidence and domain interpretation." what_it_prevents="Treating reachability, degradation or restoration as component/building condition." allowed_interpretation="Connectivity state may qualify data availability and transport responsiveness." forbidden_inference="A connectivity state proves an engineering state." operational_consequence="Store connectivity state separately; do not open, close or change engineering findings from connectivity alone." source_ref="EC-03 §§21–22; A3-EC00-01 frozen guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-01&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;A · STATE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#E3F2FD;strokeColor=#FFFFFF;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="57" y="262" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-01-R" value="&lt;b&gt;CONNECTIVITY STATE ≠ ENGINEERING STATE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E3F2FD;strokeColor=#FFFFFF;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="162" y="262" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-01-P" value="Reachability, degradation or restoration being treated as component/building condition." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F6FBFF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="262" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-01-O" value="Store connectivity state separately; never open, close or change engineering findings from connectivity alone." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F6FBFF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="262" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-02" axiom_id="AX-02" canonical_statement="NETWORK HEALTH ≠ BUILDING HEALTH" domain="STATE_SEPARATION" why_it_exists="Operator/network availability and physical-building condition belong to different domains." what_it_prevents="Declaring a building healthy from network health or failed from network unavailability." allowed_interpretation="Network health indicates connectivity-domain availability only." forbidden_inference="Network status is a building-condition authority." operational_consequence="Use network telemetry to qualify evidence availability, never as substitute engineering evidence." source_ref="EC-03 §22; A3-EC00-01 frozen guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-02&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;A · STATE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#E3F2FD;strokeColor=#FFFFFF;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="57" y="314" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-02-R" value="&lt;b&gt;NETWORK HEALTH ≠ BUILDING HEALTH&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E3F2FD;strokeColor=#FFFFFF;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="162" y="314" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-02-P" value="Declaring a building healthy from network health or failed from network unavailability." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F6FBFF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="314" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-02-O" value="Use network telemetry only to qualify evidence availability; never substitute it for engineering evidence." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F6FBFF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="314" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-08" axiom_id="AX-08" canonical_statement="DEVICE OFFLINE ≠ COMPONENT FAILED" domain="STATE_SEPARATION" why_it_exists="Device silence can arise from device, power, edge or connectivity failure and does not identify physical-component state." what_it_prevents="False component-failure inference from missing telemetry." allowed_interpretation="Offline state creates a reachability/observation gap requiring investigation." forbidden_inference="An offline device proves the observed engineering component failed." operational_consequence="Record an evidence gap, retain last confirmed state where applicable and investigate root cause before defect classification." source_ref="EC-03 §22" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-08&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;A · STATE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#E3F2FD;strokeColor=#FFFFFF;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="57" y="366" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-08-R" value="&lt;b&gt;DEVICE OFFLINE ≠ COMPONENT FAILED&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E3F2FD;strokeColor=#FFFFFF;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="162" y="366" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-08-P" value="False component-failure inference from missing telemetry or device silence." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F6FBFF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="366" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-08-O" value="Record an evidence gap; retain last confirmed state where applicable; investigate root cause before defect classification. · EC-03 §22" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F6FBFF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="366" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-03" axiom_id="AX-03" canonical_statement="DEVICE IDENTITY ≠ SIM IDENTITY" domain="IDENTITY_SEPARATION" why_it_exists="HouseMaster device/domain identity is independent from operator SIM/eSIM identity." what_it_prevents="Domain identity/history changing with SIM replacement or provider lifecycle." allowed_interpretation="Connectivity identity may be mapped to an independent HouseMaster identity." forbidden_inference="SIM identity defines the HouseMaster device/domain ID." operational_consequence="Maintain separate identifiers and mappings; never derive HouseMaster IDs from SIM identifiers." source_ref="EC-03 §3; A3-EC00-01 frozen guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-03&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;B · IDENTITY&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#FFF8E1;strokeColor=#FFFFFF;fontColor=#7A5A00;" vertex="1" parent="1"><mxGeometry x="57" y="418" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-03-R" value="&lt;b&gt;DEVICE IDENTITY ≠ SIM IDENTITY&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FFF8E1;strokeColor=#FFFFFF;fontColor=#7A5A00;" vertex="1" parent="1"><mxGeometry x="162" y="418" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-03-P" value="HouseMaster domain identity/history changing with SIM replacement or provider lifecycle." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FFFCF2;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="418" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-03-O" value="Maintain separate identifiers and explicit mappings; never derive HouseMaster IDs from SIM identifiers." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FFFCF2;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="418" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-04" axiom_id="AX-04" canonical_statement="OBSERVATION ≠ EVIDENCE ≠ DEFECT" domain="EVIDENCE_ENGINEERING_TRUTH" why_it_exists="Observation requires context/provenance to support evidence; evidence requires rules/validation to support defect classification." what_it_prevents="Raw signal, note, photo or accepted record being treated as a verified defect." allowed_interpretation="Observation may support evidence; evidence may support defect through explicit gates." forbidden_inference="Observation, evidence and defect are interchangeable objects." operational_consequence="Preserve separate records and acceptance, provenance and professional-validation gates." source_ref="EC-02 §4a; A3-EC00-01 frozen guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-04&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;C · TRUTH&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#F3E8FF;strokeColor=#FFFFFF;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="57" y="470" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-04-R" value="&lt;b&gt;OBSERVATION ≠ EVIDENCE ≠ DEFECT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F3E8FF;strokeColor=#FFFFFF;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="162" y="470" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-04-P" value="Raw signal, note, photo or accepted record being treated as a verified defect." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FBF7FF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="470" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-04-O" value="Preserve separate records and explicit acceptance, provenance and professional-validation gates." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FBF7FF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="470" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-05" axiom_id="AX-05" canonical_statement="AI SIGNAL ≠ ENGINEERING FACT" domain="EVIDENCE_ENGINEERING_TRUTH" why_it_exists="ALAU AI is downstream decision-support, not engineering system of record or truth source." what_it_prevents="Model output overwriting evidence-backed HouseMaster state." allowed_interpretation="AI signal may prompt investigation or support a recommendation." forbidden_inference="Model output alone is a verified engineering fact." operational_consequence="Store AI signals separately and require evidence/domain validation before engineering-state change." source_ref="A3-P0 §11; A3-EC00-01 frozen guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-05&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;C · TRUTH&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#F3E8FF;strokeColor=#FFFFFF;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="57" y="522" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-05-R" value="&lt;b&gt;AI SIGNAL ≠ ENGINEERING FACT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F3E8FF;strokeColor=#FFFFFF;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="162" y="522" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-05-P" value="Model output overwriting evidence-backed HouseMaster state or becoming engineering truth." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FBF7FF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="522" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-05-O" value="Store AI signals separately; require evidence/domain validation before any engineering-state change." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FBF7FF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="522" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-09" axiom_id="AX-09" canonical_statement="HUMAN EVIDENCE ≠ MACHINE DEPENDENCE" domain="EVIDENCE_ENGINEERING_TRUTH" why_it_exists="Human Channel B is independent of Channel A, Beeline connectivity and device procurement." what_it_prevents="Treating all evidence as IoT-generated or blocking human inspection when machine data is unavailable." allowed_interpretation="Human/documentary input may enter HouseMaster acceptance directly with provenance." forbidden_inference="Human evidence requires Beeline connectivity or installed devices." operational_consequence="Maintain an explicit human/documentary path and the same provenance/acceptance discipline." source_ref="EC-02 §4a.3; A3-EC00-01 frozen bypass" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-09&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;C · TRUTH&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#F3E8FF;strokeColor=#FFFFFF;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="57" y="574" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-09-R" value="&lt;b&gt;HUMAN EVIDENCE ≠ MACHINE DEPENDENCE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F3E8FF;strokeColor=#FFFFFF;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="162" y="574" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-09-P" value="Treating all evidence as IoT-generated or blocking human inspection without machine data." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FBF7FF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="574" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-09-O" value="Maintain a direct human/documentary path with the same provenance and HouseMaster acceptance discipline. · EC-02 §4a.3" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FBF7FF;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="574" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-06" axiom_id="AX-06" canonical_statement="AI RECOMMENDATION ≠ AUTHORIZED DECISION" domain="AUTHORITY_OWNERSHIP" why_it_exists="Analytics/prediction may advise but has no default engineering-control authority." what_it_prevents="Autonomous action or workflow-state change from an AI recommendation alone." allowed_interpretation="Recommendation may be reviewed by a human or authorized workflow gate." forbidden_inference="AI recommendation is permission, command or approved engineering decision." operational_consequence="Route recommendations through explicit authorization and record the accountable decision." source_ref="A3-P0 §11; A3-EC00-01 frozen downstream boundary/guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-06&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;D · AUTHORITY&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#E8F7F2;strokeColor=#FFFFFF;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="57" y="626" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-06-R" value="&lt;b&gt;AI RECOMMENDATION ≠ AUTHORIZED DECISION&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E8F7F2;strokeColor=#FFFFFF;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="162" y="626" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-06-P" value="Autonomous action or workflow-state change from an AI recommendation alone." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5FBF9;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="626" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-06-O" value="Route recommendations through explicit human/authorized review and record the accountable decision." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5FBF9;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="626" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-07" axiom_id="AX-07" canonical_statement="HOSTING ≠ DOMAIN OWNERSHIP" domain="AUTHORITY_OWNERSHIP" why_it_exists="Infrastructure placement, connectivity or hosting does not transfer engineering-domain responsibility." what_it_prevents="A provider being treated as owner of HouseMaster identities, evidence, state, history or workflow." allowed_interpretation="A provider may host or transport data under explicit responsibility boundaries." forbidden_inference="Hosting or transport grants HouseMaster domain ownership or building-condition authority." operational_consequence="Preserve HouseMaster system-of-record ownership in contracts, integrations and responsibility matrices." source_ref="A3-P0 §11; EC-03 §9a; A3-EC00-01 frozen guardrails" confidence="HIGH" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-07&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;D · OWNERSHIP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#E8F7F2;strokeColor=#FFFFFF;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="57" y="678" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-07-R" value="&lt;b&gt;HOSTING ≠ DOMAIN OWNERSHIP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E8F7F2;strokeColor=#FFFFFF;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="162" y="678" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-07-P" value="A provider being treated as owner of HouseMaster identities, evidence, state, history or workflow." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5FBF9;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="678" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-07-O" value="Preserve HouseMaster system-of-record ownership in contracts, integrations and responsibility matrices." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5FBF9;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="678" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="AX-10" axiom_id="AX-10" canonical_statement="HOUSEMASTER DOMAIN ACCEPTANCE ≠ OWNERSHIP TRANSFER" domain="AUTHORITY_OWNERSHIP" why_it_exists="Boundary acceptance admits or creates a canonical HouseMaster record where acceptance rules pass without transferring domain ownership." what_it_prevents="Interpreting integration crossing as external ownership of HouseMaster records or Beeline ownership transfer." allowed_interpretation="HouseMaster accepts/validates/maps input and creates a canonical domain record where rules pass." forbidden_inference="Acceptance changes domain ownership or makes the connectivity provider the HouseMaster domain owner." operational_consequence="housemaster_domain_acceptance=true; canonical_domain_record_created_where_acceptance_rules_pass=true; ownership_transfer=false" source_ref="A3-EC00-01 frozen BC-03; EC-03 §9a" confidence="HIGH / OWNER_APPROVED" status="SOURCE_SUPPORTED / REVIEW" value="&lt;b&gt;AX-10&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;D · OWNERSHIP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontStyle=1;fillColor=#E8F7F2;strokeColor=#FFFFFF;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="57" y="730" width="105" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-10-R" value="&lt;b&gt;HOUSEMASTER DOMAIN ACCEPTANCE ≠ OWNERSHIP TRANSFER&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E8F7F2;strokeColor=#FFFFFF;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="162" y="730" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-10-P" value="Integration crossing being interpreted as external ownership of HouseMaster domain records." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5FBF9;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="592" y="730" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="AX-10-O" value="HouseMaster accepts/validates/maps input and creates a canonical record where rules pass; ownership_transfer remains false. · OWNER-APPROVED BC-03" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5FBF9;strokeColor=#FFFFFF;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1022" y="730" width="508" height="52" as="geometry"/></mxCell>

        <mxCell id="DC1" value="&lt;b&gt;REAL BUILDING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Physical source of engineering reality.&lt;br&gt;Physical condition ≠ connectivity / software / AI state.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F5F5F5;strokeColor=#757575;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="57" y="800" width="281" height="88" as="geometry"/></mxCell>
        <mxCell id="DC2" value="&lt;b&gt;BEELINE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Connectivity / IoT-M2M / SIM-eSIM / operator transport / exposed state.&lt;br&gt;Not domain owner; not building-condition authority.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#FFF7CC;strokeColor=#D6A700;fontColor=#665000;" vertex="1" parent="1"><mxGeometry x="355" y="800" width="281" height="88" as="geometry"/></mxCell>
        <mxCell id="DC3" value="&lt;b&gt;HOUSEMASTER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Independent system of record: identities · observation/evidence · engineering state · history/workflow.&lt;br&gt;Accepts / validates / maps at boundary.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E8F0FE;strokeColor=#2457A6;fontColor=#153A73;" vertex="1" parent="1"><mxGeometry x="653" y="800" width="281" height="88" as="geometry"/></mxCell>
        <mxCell id="DC4" value="&lt;b&gt;ALAU AI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Downstream intelligence / prediction / decision-support.&lt;br&gt;Not system of record · not engineering truth · no autonomous control.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#E8F7F2;strokeColor=#2E7D6E;fontColor=#185246;" vertex="1" parent="1"><mxGeometry x="951" y="800" width="281" height="88" as="geometry"/></mxCell>
        <mxCell id="DC5" value="&lt;b&gt;HUMAN / DOCUMENTARY CHANNEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Evidence-bearing input without Beeline connectivity.&lt;br&gt;Provenance required · not IoT-dependent.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=9;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fillColor=#F3E8FF;strokeColor=#7B4AB5;fontColor=#4C267A;" vertex="1" parent="1"><mxGeometry x="1249" y="800" width="281" height="88" as="geometry"/></mxCell>

