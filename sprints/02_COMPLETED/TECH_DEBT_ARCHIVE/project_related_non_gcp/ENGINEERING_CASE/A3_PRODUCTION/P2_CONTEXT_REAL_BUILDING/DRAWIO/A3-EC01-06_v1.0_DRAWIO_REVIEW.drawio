        <mxCell id="title" value="&lt;div style=&quot;font-size:24px;font-weight:700;letter-spacing:0.5px;&quot;&gt;SITE SURVEY &amp;amp; 3D READINESS HANDOFF&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#52606D;margin-top:5px;&quot;&gt;A3-EC01-06 · 3D / PILOT READINESS MATRIX&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#14213D;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="760" height="62" as="geometry"/></mxCell>
        <mxCell id="control" value="&lt;div style=&quot;font-size:11px;line-height:1.45;text-align:right;&quot;&gt;&lt;b&gt;PRODUCTION&lt;/b&gt; P2-06 &amp;nbsp;·&amp;nbsp; &lt;b&gt;STAGE&lt;/b&gt; P2_CONTEXT_REAL_BUILDING&lt;br&gt;&lt;b&gt;TYPE&lt;/b&gt; PT-06 REFERENCE FLOW / TBD REGISTER&lt;br&gt;&lt;b&gt;IR&lt;/b&gt; FROZEN &amp;nbsp;·&amp;nbsp; &lt;b&gt;PAGE SPEC&lt;/b&gt; PAGE_SPEC_READY&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=right;verticalAlign=middle;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="1040" y="24" width="510" height="62" as="geometry"/></mxCell>
        <mxCell id="question" value="&lt;div style=&quot;font-size:12px;font-weight:700;color:#14213D;&quot;&gt;PRIMARY ENGINEERING QUESTION&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.35;margin-top:5px;&quot;&gt;What EC-01 site-survey and MCD-baseline facts are actually usable for 3D massing and pilot work today, and which remain blocked pending field validation?&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#8FA3B8;align=left;verticalAlign=middle;spacing=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="36" y="98" width="1010" height="72" as="geometry"/></mxCell>
        <mxCell id="thesis" value="&lt;div style=&quot;font-size:12px;font-weight:700;color:#14213D;&quot;&gt;CORE THESIS&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;line-height:1.3;margin-top:5px;&quot;&gt;3D MASSING MAY PROCEED ON FLOOR COUNT AND FOOTPRINT SHAPE ALONE.&lt;/div&gt;&lt;div style=&quot;font-size:10px;margin-top:4px;&quot;&gt;Nothing else is ready. Unknown engineering geometry remains unknown in 3D.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#C9A94E;align=left;verticalAlign=middle;spacing=10;fontColor=#3A3427;" vertex="1" parent="1"><mxGeometry x="1060" y="98" width="490" height="72" as="geometry"/></mxCell>
        <mxCell id="matrix" value="&lt;div style=&quot;font-size:12px;font-weight:700;color:#14213D;margin-bottom:5px;&quot;&gt;PRIMARY VISUAL — 3D USABILITY MATRIX &amp;nbsp;&lt;span style=&quot;font-size:9px;font-weight:400;color:#52606D;&quot;&gt;(7 rows, source order preserved · 6 of 7 require field confirmation)&lt;/span&gt;&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;table-layout:fixed;font-family:Arial;font-size:9.5px;line-height:1.25;color:#1F2933;&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:19%&quot;&gt;&lt;col style=&quot;width:15%&quot;&gt;&lt;col style=&quot;width:27%&quot;&gt;&lt;col style=&quot;width:13%&quot;&gt;&lt;col style=&quot;width:16%&quot;&gt;&lt;col style=&quot;width:10%&quot;&gt;&lt;/colgroup&gt;&lt;thead&gt;&lt;tr style=&quot;background:#243B53;color:#FFFFFF;font-size:10px;&quot;&gt;&lt;th style=&quot;padding:6px;border:1px solid #8FA3B8;text-align:left;&quot;&gt;FACT&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #8FA3B8;text-align:left;&quot;&gt;DIRECT USE IN BLENDER?&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #8FA3B8;text-align:left;&quot;&gt;USE AS CONSTRAINT?&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #8FA3B8;text-align:center;&quot;&gt;NEEDS FIELD CONFIRMATION?&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #8FA3B8;text-align:left;&quot;&gt;DO NOT MODEL&lt;/th&gt;&lt;th style=&quot;padding:6px;border:1px solid #8FA3B8;text-align:center;&quot;&gt;PROVENANCE&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style=&quot;background:#FFFFFF;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;9 floors&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;Yes&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;color:#7A8794;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#E8F5E9;border:1px solid #2E7D32;color:#1B5E20;font-weight:700;font-size:9px;&quot;&gt;VERIFIED&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F7F9FB;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;Stepped (non-rectangular) footprint outline, Image 3&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No — dimensions incomplete&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;Yes — DERIVED constraint on massing shape, supersedes a simple-rectangle assumption&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;font-weight:700;color:#8A3B00;&quot;&gt;Yes, before final massing&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#EEF5E9;border:1px solid #689F38;color:#33691E;font-weight:700;font-size:9px;&quot;&gt;DERIVED&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFFFF;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;Footprint area (site-coverage)&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No — not established&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No — 1,248 m² / 550 m² are area sub-categories, not footprint values&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;font-weight:700;color:#8A3B00;&quot;&gt;Yes — needs dimensioned plan or field survey&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;Do not model any area-derived footprint&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#FFF8E1;border:1px solid #F9A825;color:#7A5A00;font-weight:700;font-size:9px;&quot;&gt;PARTIAL&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F7F9FB;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;3 entrance/staircase cores&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No exact coordinates&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;Yes, as section-count constraint&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;font-weight:700;color:#8A3B00;&quot;&gt;Yes (exact spacing)&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#F5F5F5;border:1px solid #757575;color:#424242;font-weight:700;font-size:9px;&quot;&gt;TBD&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFFFF;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;Floor plan room layout (SRC-004 photographed sheets)&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;Partial — legible portions only&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;Yes — DERIVED reference, one representative floor&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;font-weight:700;color:#8A3B00;&quot;&gt;Yes, for illegible dimensions&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#FFF8E1;border:1px solid #F9A825;color:#7A5A00;font-weight:700;font-size:9px;&quot;&gt;PARTIAL&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F7F9FB;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;Roof/basement&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;font-weight:700;color:#8A3B00;&quot;&gt;Yes&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;Do not invent&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#F5F5F5;border:1px solid #757575;color:#424242;font-weight:700;font-size:9px;&quot;&gt;TBD&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFFFF;&quot;&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;font-weight:700;&quot;&gt;Engineering rooms/risers&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;font-weight:700;color:#8A3B00;&quot;&gt;Yes&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;color:#8E0000;&quot;&gt;Do not invent — no location evidence exists&lt;/td&gt;&lt;td style=&quot;padding:6px;border:1px solid #CBD5E1;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#F5F5F5;border:1px solid #757575;color:#424242;font-weight:700;font-size:9px;&quot;&gt;TBD&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA3B8;align=left;verticalAlign=top;spacing=10;overflow=fill;" vertex="1" parent="1"><mxGeometry x="36" y="184" width="1514" height="350" as="geometry"/></mxCell>
        <mxCell id="gaplist" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#14213D;margin-bottom:6px;&quot;&gt;SITE-SURVEY / FIELD-CONFIRMATION GAPS &amp;nbsp;&lt;span style=&quot;font-size:9px;font-weight:400;color:#52606D;&quot;&gt;(5 categories)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background:#FFFFFF;border:1px solid #CBD5E1;border-radius:3px;padding:6px 8px;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;font-weight:700;font-size:9.5px;color:#14213D;&quot;&gt;PHYSICAL&lt;/span&gt;&lt;div style=&quot;font-size:9px;line-height:1.3;margin-top:2px;color:#1F2933;&quot;&gt;Entrance layout/numbering vs. documented layout; basement access; technical-room locations; roof access; footprint outline verification.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;background:#F7F9FB;border:1px solid #CBD5E1;border-radius:3px;padding:6px 8px;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;font-weight:700;font-size:9.5px;color:#14213D;&quot;&gt;ENGINEERING&lt;/span&gt;&lt;div style=&quot;font-size:9px;line-height:1.3;margin-top:2px;color:#1F2933;&quot;&gt;Heat entry/metering, water entry/meter, electrical main board, sewer collector/outlet locations; gas presence/absence.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;background:#FFFFFF;border:1px solid #CBD5E1;border-radius:3px;padding:6px 8px;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;font-weight:700;font-size:9.5px;color:#14213D;&quot;&gt;DEVICE DEPLOYMENT&lt;/span&gt;&lt;div style=&quot;font-size:9px;line-height:1.3;margin-top:2px;color:#1F2933;&quot;&gt;Mounting positions, available power, environmental conditions, access restrictions — none currently known.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;background:#F7F9FB;border:1px solid #CBD5E1;border-radius:3px;padding:6px 8px;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;font-weight:700;font-size:9.5px;color:#14213D;&quot;&gt;CONNECTIVITY&lt;/span&gt;&lt;div style=&quot;font-size:9px;line-height:1.3;margin-top:2px;color:#1F2933;&quot;&gt;Cellular signal conditions, basement/technical-room penetration, candidate edge location, direct-cellular feasibility — TBD WITH BEELINE / SITE SURVEY.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;background:#FFFFFF;border:1px solid #CBD5E1;border-radius:3px;padding:6px 8px;margin-bottom:5px;&quot;&gt;&lt;span style=&quot;font-weight:700;font-size:9.5px;color:#14213D;&quot;&gt;DOCUMENTATION&lt;/span&gt;&lt;div style=&quot;font-size:9px;line-height:1.3;margin-top:2px;color:#1F2933;&quot;&gt;Legible cover-page identity confirmation; original dimensioned site/footprint plan or field survey.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA3B8;align=left;verticalAlign=top;spacing=10;overflow=fill;" vertex="1" parent="1"><mxGeometry x="36" y="550" width="488" height="252" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#14213D;margin-bottom:6px;&quot;&gt;EVIDENCE / PROVENANCE STATES &amp;nbsp;&lt;span style=&quot;font-size:9px;font-weight:400;color:#52606D;&quot;&gt;(5 states)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display:flex;align-items:center;margin-bottom:5px;&quot;&gt;&lt;div style=&quot;flex:0 0 88px;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#E8F5E9;border:1px solid #2E7D32;color:#1B5E20;font-weight:700;font-size:9px;&quot;&gt;VERIFIED&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#1F2933;&quot;&gt;Directly usable now.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;display:flex;align-items:center;margin-bottom:5px;&quot;&gt;&lt;div style=&quot;flex:0 0 88px;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#EEF5E9;border:1px solid #689F38;color:#33691E;font-weight:700;font-size:9px;&quot;&gt;DERIVED&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#1F2933;&quot;&gt;Explicit constraint derived from evidence, not a direct source fact.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;display:flex;align-items:center;margin-bottom:5px;&quot;&gt;&lt;div style=&quot;flex:0 0 88px;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#FFF8E1;border:1px solid #F9A825;color:#7A5A00;font-weight:700;font-size:9px;&quot;&gt;PARTIAL&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#1F2933;&quot;&gt;Some evidence exists; not established.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;display:flex;align-items:center;margin-bottom:5px;&quot;&gt;&lt;div style=&quot;flex:0 0 88px;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#F5F5F5;border:1px solid #757575;color:#424242;font-weight:700;font-size:9px;&quot;&gt;TBD&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#1F2933;&quot;&gt;Not established; requires field confirmation.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;display:flex;align-items:center;margin-bottom:5px;&quot;&gt;&lt;div style=&quot;flex:0 0 88px;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#FAFAFA;border:1px solid #9E9E9E;color:#616161;font-weight:700;font-size:9px;&quot;&gt;NO EVIDENCE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#1F2933;&quot;&gt;Reviewed evidence does not support the claim — absence is not proved.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#52606D;margin-top:4px;&quot;&gt;Epistemic evidence axis, not a severity ladder.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA3B8;align=left;verticalAlign=top;spacing=10;overflow=fill;" vertex="1" parent="1"><mxGeometry x="540" y="550" width="488" height="252" as="geometry"/></mxCell>
        <mxCell id="heat03" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#14213D;margin-bottom:5px;&quot;&gt;REFERENCE CANDIDATE — HEAT-03 &amp;nbsp;&lt;span style=&quot;font-size:9px;font-weight:400;color:#52606D;&quot;&gt;(not installed / not validated)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.35;color:#1F2933;&quot;&gt;&lt;b&gt;Question:&lt;/b&gt; can a real HEAT-03 (or equivalent heating mixing/elevator node) be identified from primary evidence?&lt;/div&gt;&lt;div style=&quot;margin:5px 0;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 7px;border-radius:3px;background:#FAFAFA;border:1px solid #9E9E9E;color:#616161;font-weight:700;font-size:9px;&quot;&gt;NO EVIDENCE&lt;/span&gt; &lt;span style=&quot;font-size:9px;color:#1F2933;&quot;&gt;— answer, as recorded in the frozen source extract&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.35;color:#1F2933;&quot;&gt;Central heating connection existence confirmed only; no basement plan, mixing-node location, or riser topology found.&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.35;color:#8E0000;margin-top:4px;&quot;&gt;&lt;b&gt;Boundary:&lt;/b&gt; HEAT-03 and all HEAT-xx candidates remain unassigned ontology candidates, not instantiated facts.&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#52606D;margin-top:4px;&quot;&gt;Same fact tracked as CI-03 on A3-EC01-05 — cited here, not re-registered.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=10;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1044" y="550" width="506" height="252" as="geometry"/></mxCell>
        <mxCell id="counts" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#14213D;margin-bottom:7px;&quot;&gt;FROZEN SEMANTIC COUNTS&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;text-align:center;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border-right:1px solid #CBD5E1;&quot;&gt;&lt;b style=&quot;font-size:17px;&quot;&gt;7&lt;/b&gt;&lt;br&gt;PRIMARY UNITS&lt;/td&gt;&lt;td style=&quot;border-right:1px solid #CBD5E1;&quot;&gt;&lt;b style=&quot;font-size:17px;&quot;&gt;5&lt;/b&gt;&lt;br&gt;SECONDARY UNITS&lt;/td&gt;&lt;td style=&quot;border-right:1px solid #CBD5E1;&quot;&gt;&lt;b style=&quot;font-size:17px;&quot;&gt;6&lt;/b&gt;&lt;br&gt;RELATIONSHIPS&lt;/td&gt;&lt;td style=&quot;border-right:1px solid #CBD5E1;&quot;&gt;&lt;b style=&quot;font-size:17px;&quot;&gt;5&lt;/b&gt;&lt;br&gt;EVIDENCE STATES&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;font-size:17px;&quot;&gt;7&lt;/b&gt;&lt;br&gt;OPEN / TBD&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#8FA3B8;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="36" y="816" width="900" height="92" as="geometry"/></mxCell>
        <mxCell id="discipline" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#14213D;&quot;&gt;VALIDATION &amp;amp; INCLUSION DISCIPLINE&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;margin-top:5px;&quot;&gt;&lt;b&gt;VALIDATION REQUIREMENT COUNT:&lt;/b&gt; 6 &amp;nbsp;·&amp;nbsp; &lt;b&gt;GUARDRAIL COUNT:&lt;/b&gt; 2&lt;br&gt;&lt;b&gt;SEM-MCD-001 INCLUDED:&lt;/b&gt; YES &amp;nbsp;·&amp;nbsp; &lt;b&gt;HEAT-03 INCLUDED:&lt;/b&gt; YES&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA3B8;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="950" y="816" width="600" height="92" as="geometry"/></mxCell>
        <mxCell id="guardrail" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#6B4F00;&quot;&gt;GUARDRAILS — 2&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:700;line-height:1.35;margin-top:4px;&quot;&gt;1. UNKNOWN ENGINEERING GEOMETRY REMAINS UNKNOWN IN 3D — THIS PAGE DOES NOT CREATE OR MODIFY ANY 3D GEOMETRY.&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:700;line-height:1.35;margin-top:4px;&quot;&gt;2. HEAT-03 AND ALL HEAT-xx CANDIDATES REMAIN UNASSIGNED ONTOLOGY CANDIDATES, NOT INSTANTIATED FACTS.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#C9A94E;align=left;verticalAlign=middle;spacing=11;fontColor=#3A3427;" vertex="1" parent="1"><mxGeometry x="36" y="922" width="850" height="78" as="geometry"/></mxCell>
        <mxCell id="exclusions" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#14213D;&quot;&gt;PROHIBITED INFERENCE&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.3;margin-top:5px;&quot;&gt;No installed device, confirmed location, validated topology, or completed field confirmation.&lt;br&gt;Missing evidence ≠ absence of an object. Unknown geometry is not shown as known geometry.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA3B8;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="900" y="922" width="650" height="78" as="geometry"/></mxCell>
        <mxCell id="footer" value="&lt;div style=&quot;font-size:9px;line-height:1.45;&quot;&gt;&lt;b&gt;PAGE / GRAPH:&lt;/b&gt; A3-EC01-06 &amp;nbsp;·&amp;nbsp; &lt;b&gt;PRODUCTION:&lt;/b&gt; P2-06 &amp;nbsp;·&amp;nbsp; &lt;b&gt;TYPE:&lt;/b&gt; PT-06 REFERENCE FLOW / TBD REGISTER &amp;nbsp;·&amp;nbsp; &lt;b&gt;SOURCE:&lt;/b&gt; EC-01 §11, §12, §13 (via frozen GRAPH_IR / PAGE_SPEC)&lt;br&gt;&lt;b&gt;PRIMARY UNITS:&lt;/b&gt; 7 &amp;nbsp;·&amp;nbsp; &lt;b&gt;SECONDARY UNITS:&lt;/b&gt; 5 &amp;nbsp;·&amp;nbsp; &lt;b&gt;RELATIONSHIPS:&lt;/b&gt; 6 &amp;nbsp;·&amp;nbsp; &lt;b&gt;EVIDENCE STATES:&lt;/b&gt; 5 &amp;nbsp;·&amp;nbsp; &lt;b&gt;OPEN/TBD:&lt;/b&gt; 7 &amp;nbsp;·&amp;nbsp; &lt;b&gt;VALIDATION REQ:&lt;/b&gt; 6 &amp;nbsp;·&amp;nbsp; &lt;b&gt;GUARDRAILS:&lt;/b&gt; 2 &amp;nbsp;·&amp;nbsp; &lt;b&gt;SEM-MCD-001:&lt;/b&gt; YES &amp;nbsp;·&amp;nbsp; &lt;b&gt;HEAT-03:&lt;/b&gt; YES &amp;nbsp;·&amp;nbsp; &lt;b&gt;IR:&lt;/b&gt; FROZEN &amp;nbsp;·&amp;nbsp; &lt;b&gt;PAGE SPEC:&lt;/b&gt; PAGE_SPEC_READY&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243B53;strokeColor=#243B53;align=left;verticalAlign=middle;spacing=9;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="36" y="1014" width="1514" height="72" as="geometry"/></mxCell>
