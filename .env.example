# =============================================================================
# HouseMaster — контракт переменных окружения
# =============================================================================
# Скопируйте в .env (файл .env добавлен в .gitignore и НИКОГДА не коммитится).
# В GCP значения поставляются из Secret Manager / конфигурации Cloud Run,
# состав переменных идентичен для dev и prod (различаются только значения).
# =============================================================================

# --- Auth (Auth.js v5) — два контура, см. ADR-0004 ---------------------------
# Ниже — переменные АДМИН-контура (HM-005): Google Workspace, клиент Internal.
# Переменные контура Users (HM-006: второй OAuth-клиент, SMTP для верификации
# e-mail и сброса пароля) будут добавлены при реализации HM-006.
# OAuth-клиент создаётся в Google Cloud Console (см. docs/gcp/oauth-setup.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Секрет подписи сессий Auth.js (сгенерировать: npx auth secret)
AUTH_SECRET=
# Базовый URL приложения (локально: http://localhost:3000)
AUTH_URL=

# Админ-контур: разрешённый домен Google Workspace.
# Проверяется НА СЕРВЕРЕ по claim hd из ID-токена (hd в запросе — лишь UX-фильтр).
ALLOWED_WORKSPACE_DOMAIN=

# Примечание: Auth.js v4 использовал имена NEXTAUTH_SECRET / NEXTAUTH_URL.
# Проект стандартизируется на v5-именах AUTH_SECRET / AUTH_URL.

# --- Google Cloud Platform ---------------------------------------------------
PROJECT_ID=
REGION=

# --- База данных: Cloud SQL (PostgreSQL), см. ADR-0003 -----------------------
# Локально: postgresql://user:password@localhost:5432/housemaster
DATABASE_URL=
# Имя подключения инстанса Cloud SQL: project:region:instance
# (используется Cloud SQL connector'ом в Cloud Run; локально не нужно)
CLOUD_SQL_CONNECTION=

# --- Cloud Storage -----------------------------------------------------------
BUCKET_IMAGES=
BUCKET_DOCS=
BUCKET_MEDIA=

# --- Vertex AI ---------------------------------------------------------------
# Локация Vertex AI может отличаться от REGION (доступность моделей)
VERTEX_LOCATION=
# Идентификатор индекса Vector Search (появится на фазе Knowledge Base)
VECTOR_SEARCH_INDEX=

# --- Async: Pub/Sub ----------------------------------------------------------
# Топик задач AI-конвейера (появится на фазе Knowledge Base / AI Inspection)
PUBSUB_TOPIC_INGEST=

# --- Runtime -----------------------------------------------------------------
# Cloud Run передаёт PORT сам; локально Next.js использует 3000 по умолчанию.
# PORT=
NODE_ENV=development
